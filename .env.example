# Local MySQL profile (copy to .env for docker/local runs; never commit).
DB_URL=jdbc:mysql://127.0.0.1:3306/quizdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=quizapp
DB_PASSWORD=

# --- Production values (Render environment variables) ---
# Aiven gives you a URI like:
#   mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
# Convert it to JDBC by prefixing jdbc: and keeping the host/port/db/query:
# DB_URL=jdbc:mysql://HOST:PORT/defaultdb?ssl-mode=REQUIRED&serverTimezone=UTC
# DB_USERNAME=avnadmin
# DB_PASSWORD=<from Aiven console>

# 48+ characters. Render generates this automatically via render.yaml.
# JWT_SECRET=

# Browser origin allowed to call the API (your Vercel URL).
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Demo accounts seeded only on an empty database. Set the password before first boot.
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_PASSWORD=

# --- Frontend (Vercel environment variable, build time) ---
# VITE_API_BASE=https://your-api.onrender.com
